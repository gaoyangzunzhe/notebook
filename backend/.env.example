# ===== 对话模型配置（默认 DeepSeek，OpenAI 兼容协议）=====
# 统一前缀：LLM_* = 对话模型，EMBED_* = 嵌入模型，避免与其它配置歧义。
# 这些是全局默认值；用户可在设置页覆盖自己的 provider/model/自定义接口地址/API Key，
# 覆盖后存 user_settings 表（API Key 用 SECRET_KEY 派生密钥加密存储）。
LLM_API_KEY="<YOUR_DEEPSEEK_API_KEY>"
LLM_BASE_URL="https://api.deepseek.com"
LLM_MODEL="deepseek-v4-flash"
LLM_TEMPERATURE=0.2

# ===== 嵌入模型配置（默认 DashScope / 阿里云百炼，OpenAI 兼容协议）=====
EMBED_MODEL="text-embedding-v4"
EMBED_API_KEY="<YOUR_DASHSCOPE_API_KEY>"
EMBED_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
# 单次嵌入请求批量上限（DashScope ≤20；OpenAI 可用更高）。超限文档自动拆批。
EMBED_BATCH_SIZE=20

# ===== AI 调用护栏（可选，默认值见下）=====
# 每用户每小时 AI 调用上限（RAG 提问/辅助写作/自动分类/上传），0 = 关闭
AI_QUOTA_LIMIT=30
# 全局并发 LLM/嵌入调用上限（防重试风暴打爆成本）
AI_MAX_CONCURRENT_LLM=4
# 单次 LLM/嵌入请求超时（秒）与重试次数（OpenAI SDK 指数退避）
LLM_REQUEST_TIMEOUT=120
LLM_MAX_RETRIES=2
EMBED_REQUEST_TIMEOUT=120
EMBED_MAX_RETRIES=2
# 提供商模型列表在线拉取缓存时长（秒）
MODEL_CACHE_TTL_SECONDS=300
# Redis 连接串（可选）：配置后启用模型列表缓存；留空 = 缓存禁用，功能不受影响。
# 例：REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# ===== LangSmith 链路追踪（可选）=====
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=notebook_rag
LANGCHAIN_API_KEY="<YOUR_LANGSMITH_API_KEY>"

# ===== 数据库配置（注意驱动名是 asyncpg，勿写错）=====
DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:5432/note_book

# ===== 认证（JWT）=====
# SECRET_KEY 除签名 JWT 外，也作为派生密钥加密用户级 API Key：
# 轮换 SECRET_KEY 会让已保存的用户 Key 无法解密（自动回退到全局 LLM_API_KEY / EMBED_API_KEY）。
SECRET_KEY="<GENERATE_A_RANDOM_STRING_MIN_32_CHARS>"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
